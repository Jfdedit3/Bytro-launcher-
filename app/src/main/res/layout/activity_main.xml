<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_color">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="18dp" android:paddingHorizontal="16dp"
            android:paddingBottom="12dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="54dp" android:layout_height="54dp"
                android:gravity="center" android:text="▧" android:textSize="31sp"
                android:textColor="#FFFFFF" android:background="@drawable/gallery_logo"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ma Galerie" android:textSize="25sp" android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/galleryStatus" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Chargement des médias..."
                    android:textSize="12sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
            <TextView android:id="@+id/searchToggle" android:layout_width="46dp"
                android:layout_height="46dp" android:gravity="center" android:text="⌕"
                android:contentDescription="Rechercher" android:textSize="31sp"
                android:textColor="@color/text_primary"/>
            <TextView android:id="@+id/menuButton" android:layout_width="36dp"
                android:layout_height="46dp" android:gravity="center" android:text="⋮"
                android:contentDescription="Menu" android:textSize="27sp"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <EditText android:id="@+id/searchInput" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp" android:paddingHorizontal="14dp"
            android:background="@drawable/gallery_search"
            android:hint="Rechercher un fichier ou un album"
            android:visibility="gone" android:singleLine="true"
            android:inputType="text" android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <LinearLayout android:id="@+id/filterRow" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingHorizontal="12dp"
            android:paddingTop="6dp" android:paddingBottom="14dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/allButton" style="@style/GalleryFilter"
                android:text="▧  Tous"/>
            <TextView android:id="@+id/photosButton" style="@style/GalleryFilter"
                android:text="▣  Photos"/>
            <TextView android:id="@+id/videosButton" style="@style/GalleryFilter"
                android:text="⊙  Vidéos"/>
            <TextView android:id="@+id/favoritesButton" style="@style/GalleryFilter"
                android:text="♡  Favoris"/>
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <GridView android:id="@+id/mediaGrid"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:numColumns="3" android:stretchMode="columnWidth"
                android:horizontalSpacing="5dp" android:verticalSpacing="5dp"
                android:paddingHorizontal="8dp" android:paddingBottom="14dp"
                android:clipToPadding="false" android:scrollbars="none"/>
            <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center"
                android:orientation="vertical" android:visibility="gone" android:padding="28dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="▧" android:textSize="62sp" android:textColor="@color/accent_color"/>
                <TextView android:id="@+id/emptyTitle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Aucun média"
                    android:textSize="19sp" android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/emptySubtitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:gravity="center" android:text="Tes photos et vidéos apparaîtront ici."
                    android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/loadingIndicator" android:layout_width="48dp"
                android:layout_height="48dp" android:layout_gravity="center"
                android:visibility="gone" android:indeterminateTint="@color/accent_color"/>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="74dp"
            android:paddingHorizontal="8dp" android:paddingTop="7dp"
            android:background="@drawable/gallery_nav_background"
            android:orientation="horizontal">
            <TextView android:id="@+id/navGallery" style="@style/GalleryNav"
                android:text="▧&#10;Galerie"/>
            <TextView android:id="@+id/navAlbums" style="@style/GalleryNav"
                android:text="▱&#10;Albums"/>
            <TextView android:id="@+id/navFavorites" style="@style/GalleryNav"
                android:text="♡&#10;Favoris"/>
            <TextView android:id="@+id/navStats" style="@style/GalleryNav"
                android:text="▥&#10;Statistiques"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>