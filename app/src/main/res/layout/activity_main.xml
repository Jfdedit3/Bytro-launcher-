<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical"
    android:paddingTop="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:text="MA GALERIE"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/galleryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:text="Chargement..."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">
        <Button android:id="@+id/allButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Tout"/>
        <Button android:id="@+id/photosButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Photos"/>
        <Button android:id="@+id/videosButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Vidéos"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingHorizontal="8dp">
        <Button android:id="@+id/refreshButton"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Actualiser"/>
        <Button android:id="@+id/permissionsButton"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Autorisation"/>
    </LinearLayout>

    <GridView
        android:id="@+id/mediaGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        android:horizontalSpacing="3dp"
        android:verticalSpacing="3dp"
        android:stretchMode="columnWidth"
        android:numColumns="3" />
</LinearLayout>
